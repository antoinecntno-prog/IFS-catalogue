/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Les photos portent une empreinte de leur contenu dans leur nom (outils/photos.py) :
# une photo remplacée change de nom, le cache peut donc durer un an.
/img/*
  Cache-Control: public, max-age=31536000, immutable
